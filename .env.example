# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-generated-secret-key-here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dpdp_shield

# Redis
REDIS_URL=redis://redis:6379/0

# AWS (required for production, optional for local)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_CONSENT_PROOFS=dpdp-shield-consent-proofs
S3_BUCKET_TEMP=dpdp-shield-temp

# Razorpay (required for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
SES_FROM_EMAIL=noreply@dpdp-shield.in

# SMS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Application
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
